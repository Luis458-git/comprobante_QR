    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Normalización a contrato común: { ok, data, error }\ntry {\n  const items = $input.all().map(i => i.json);\n  return [{\n    json: {\n      ok: true,\n      data: {\n        total: items.length,\n        pagos: items\n      },\n      error: null\n    }\n  }];\n} catch (error) {\n  return [{\n    json: {\n      ok: false,\n      data: null,\n      error: error.message || 'Error al obtener pagos pendientes'\n    }\n  }];\n}"
      },
      "id": "node-sub1-code-format",
      "name": "Code - Formatear Salida Estandar",
